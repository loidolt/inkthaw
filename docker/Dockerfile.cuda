# syntax=docker/dockerfile:1.7
# NVIDIA GPU image (linux/amd64). Needs the NVIDIA Container Toolkit on the host
# and a driver that supports CUDA 13.2.
FROM nvidia/cuda:13.2.1-runtime-ubuntu24.04

ARG BAKE_MODELS=0
# PyTorch wheel index for CUDA 13.2. The locked torch version (2.15.0) is
# published for cu132 and cu134, not for 12.x; the host driver must support
# CUDA 13.2.
ARG TORCH_INDEX=https://download.pytorch.org/whl/cu132
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON=python3.12 \
    PATH=/opt/venv/bin:$PATH \
    UV_CACHE_DIR=/root/.cache/uv

# Ubuntu 24.04 ships Python 3.12. No poppler, unpaper or pandoc: PDFium, the
# built-in preprocess backend and the EPUB writer run in-process.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv \
        epubcheck default-jre-headless \
        libglib2.0-0 libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.22 /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE THIRD_PARTY_LICENSES.md ./
# The lock file pins CPU-only torch on Linux. Install the CUDA build of the same
# torch/torchvision versions first (from TORCH_INDEX), then every other locked
# dependency, which then finds torch already satisfied. One layer, so no other
# copy of torch is left in the image.
RUN --mount=type=cache,target=/root/.cache/uv \
    set -e; \
    uv venv /opt/venv; \
    uv export --locked --no-dev --extra docling --no-hashes --no-annotate --no-header \
        --no-emit-project > /tmp/all.txt; \
    pin() { sed -n "s/^$1==\([0-9.]*\)+cpu ; sys_platform == 'linux'$/\1/p" /tmp/all.txt; }; \
    TORCH=$(pin torch); VISION=$(pin torchvision); \
    test -n "$TORCH" && test -n "$VISION"; \
    grep -vE "^torch(vision)?==" /tmp/all.txt > /tmp/deps.txt; \
    uv pip install --python /opt/venv/bin/python --index-url "$TORCH_INDEX" \
        "torch==$TORCH" "torchvision==$VISION"; \
    uv pip install --python /opt/venv/bin/python -r /tmp/deps.txt; \
    /opt/venv/bin/python -c "import torch; print('torch', torch.__version__)"; \
    rm /tmp/all.txt /tmp/deps.txt
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /opt/venv/bin/python --no-deps .

# Runtime: any UID may run the container (compose sets user:), so HOME and
# caches must not point at root-owned paths.
ENV INKTHAW_MODELS_DIR=/models \
    HF_HOME=/models/huggingface \
    HOME=/tmp
RUN mkdir -p /models /data && chmod 0777 /models /data \
    && if [ "$BAKE_MODELS" = "1" ]; then inkthaw models && chmod -R a+rX /models; fi

WORKDIR /data
ENTRYPOINT ["inkthaw"]
CMD ["watch", "/data/inbox", "--out", "/data/outbox", "--jobs-dir", "/data/jobs"]
